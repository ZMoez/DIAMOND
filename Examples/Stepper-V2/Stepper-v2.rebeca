reactiveclass Stepper (3){
    statevars {
        int x;
    }

    Stepper() {
        x = 0;
        self.step();
    }

    msgsrv step() {
        if (x < 6) 
        {
            if (x == 3 && ?(true, false)) 
                self.reset();
            else if (x == 4)
                x = ?(5, 6);  // Change: non-deterministically choose 5 or 6
            else 
                x = x + 1;    
        } 
        else 
        {  
            self.reset();
        }
        self.step();
    }
    
    void reset(){
        x = 0;
    }
}

main {
    Stepper stepper():();
}

